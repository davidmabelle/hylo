{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "YARN2_WORKSPACE_PATH=apps/backend bash heroku-postbuild.sh"
  },
  "deploy": {
    "startCommand": "yarn workspace backend migrate && yarn workspace backend start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
