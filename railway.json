{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "YARN2_WORKSPACE_PATH=apps/web bash heroku-postbuild.sh"
  },
  "deploy": {
    "startCommand": "node apps/web/dist/server/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}